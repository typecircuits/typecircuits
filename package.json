{
    "private": true,
    "workspaces": [
        "core",
        "app",
        "functions"
    ],
    "scripts": {
        "build": "./build.sh",
        "dev": "(cd core && npm run build) && (cd app && npm run dev)",
        "serve": "netlify dev --filter app --offline",
        "format": "prettier --write ."
    },
    "devDependencies": {
        "prettier": "^3.9.10",
        "prettier-plugin-svelte": "^4.1.1",
        "prettier-plugin-tailwindcss": "^0.8.1"
    }
}
